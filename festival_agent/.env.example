ANTHROPIC_API_KEY=sk-ant-...

# 에이전트 두뇌
#   anthropic   = 실제 모델, API 키 사용 (제출본)
#   claude_code = 실제 모델, 이 PC 의 Claude Code CLI(`claude -p`) 경유 (개발용, 구독 사용량 소모)
#   local       = 규칙 기반 대역 (개발 전용)
# 비워 두면 ANTHROPIC_API_KEY 유무로 anthropic/local 을 자동 선택합니다 (claude_code 는 명시해야 함).
LLM_BACKEND=

# 한국관광공사 TourAPI (선택) — data.go.kr > 한국관광공사_국문 관광정보 서비스_GW
# 마이페이지 > 개발계정 > 일반 인증키(Decoding) 를 붙여넣으세요
TOURAPI_KEY=

# DB_PATH=festival.db

# 운영자 코드 — 민원 지우기·조치 상태 변경·조치요청서 생성은 이 코드가 맞을 때만 실행됩니다.
# 비워 두면 그 동작이 전부 거부됩니다. 값은 직접 정해서 여기에만 넣으세요 (채팅·문서에 적지 않기).
ADMIN_CODE=

# Supabase (선택) — 비워 두면 로컬 SQLite(festival.db) 를 씁니다.
# 대시보드 > Connect > Session pooler 연결 문자열
SUPABASE_DB_URL=
# 대시보드 > Project Settings > API (service_role 키는 워커 전용, 웹에 넣지 마세요)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# 조치요청서 DOCX 를 올릴 Storage 버킷 (schema.sql 이 'docs' 를 만듭니다)
SUPABASE_BUCKET=docs
